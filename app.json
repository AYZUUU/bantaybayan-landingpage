{
  "expo": {
    "name": "BantayBayan",
    "slug": "bantaybayan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bantaybayan.png",
    "scheme": "bantaybayanapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/bantaybayan.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ayzu.bantaybayan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bantaybayan.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BantayBayan to access your photos so you can choose a profile picture."
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "Allow BantayBayan to use your location for emergency reports and responses.",
          "locationAlwaysAndWhenInUsePermission": "Allow BantayBayan to share your location with the citizen during an active response, even in the background."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase_Impl { public <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79d170db-4a73-4f5e-971d-ea2cdea2cb79"
      }
    },
    "owner": "ayzu"
  }
}
